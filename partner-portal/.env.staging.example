# Только пример: все значения credentials ниже фиктивные, замените до запуска VM.
# Администратор отдельно создаёт ~/.config/partner-portal/staging.env на VM
# с правами 0600. Runtime-файл не коммитится и не передаётся в архиве релиза.
# Запускать с постоянным Compose project: --project-name partner-portal-staging.
DB_PASSWORD=replace-with-staging-db-password
S3_ACCESS_KEY=replace-with-staging-s3-user
S3_SECRET_KEY=replace-with-staging-s3-password
S3_BUCKET=partner-leads
# Два независимых значения: openssl rand -base64 32; хранить только на VM.
REGISTRATION_ENCRYPTION_KEY=
REGISTRATION_HASH_KEY=
PARTNER_REGISTRATION_APPROVED_LOGO_ASSET_KEYS=

# Frontend доступен на VM; для reverse proxy на том же хосте задайте 127.0.0.1.
PORTAL_BIND_ADDRESS=0.0.0.0
PORTAL_PORT=8088
# MCP и MinIO всегда привязаны к 127.0.0.1 в compose.yaml.
MCP_PORT=8081
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
MCP_BACKEND_TIMEOUT=PT10S
MCP_MAX_REQUEST_BYTES=31457280

# Включать внешнюю аутентификацию только после настройки HTTPS и credentials.
YANDEX_ID_ENABLED=false
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8088/api/v1/auth/yandex/callback
# После настройки HTTPS задать true и HTTPS callback URI выше.
SESSION_COOKIE_SECURE=false
LDAP_ENABLED=false
LDAP_URL=
LDAP_USERS_DN=
# При включении LDAPS задайте абсолютный путь к CA-сертификату на VM.
LDAP_CA_CERT_SOURCE=./certs/simbirsoft-ca.crt
LDAP_CONNECT_TIMEOUT=PT3S
LDAP_READ_TIMEOUT=PT3S

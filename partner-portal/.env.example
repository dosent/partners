# Только фиктивные значения для локальной разработки. Замените перед запуском.
DB_PASSWORD=local-development-only-change-me
# Сгенерировать два независимых значения командой openssl rand -base64 32;
# реальные ключи держать только в локальном .env или secret store.
REGISTRATION_ENCRYPTION_KEY=
REGISTRATION_HASH_KEY=
S3_ACCESS_KEY=local-s3-user
S3_SECRET_KEY=local-development-s3-password
PORTAL_PORT=8088
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# Партнёрский вход через Yandex ID: задайте после регистрации OAuth-приложения.
YANDEX_ID_ENABLED=false
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8088/api/v1/auth/yandex/callback
# Для production установите true за HTTPS.
SESSION_COOKIE_SECURE=false

# Вход сотрудников через LDAPS. Рабочие URL и group DN добавьте только в локальный .env/secret store.
LDAP_ENABLED=false
LDAP_URL=
LDAP_USER_DN_PATTERN=uid={0},ou=people,dc=example,dc=com
LDAP_GROUP_SEARCH_BASE=
LDAP_GROUP_SEARCH_FILTER=(&(objectClass=groupOfNames)(member={0}))
LDAP_CONNECT_TIMEOUT=PT3S
LDAP_READ_TIMEOUT=PT3S
LDAP_GROUP_PARTNER_MANAGER=
LDAP_GROUP_RESOURCE_MANAGER=
LDAP_GROUP_FINANCE_CONTROLLER=
LDAP_GROUP_SYSTEM_ADMIN=
